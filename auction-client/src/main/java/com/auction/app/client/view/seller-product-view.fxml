<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.auction.app.client.controller.SellerProductController"
            prefWidth="980" prefHeight="620">

    <top>
        <HBox spacing="12" alignment="CENTER_LEFT" style="-fx-padding: 14 20; -fx-border-color: #cccccc; -fx-border-width: 0 0 1 0;">
            <Button text="← Quay lại trang chủ" onAction="#handleBack"/>
            <Label text="Quản lý kho sản phẩm của người bán" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Tải lại danh sách" onAction="#handleRefresh"/>
        </HBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.62">
            <!-- Bảng danh sách sản phẩm bên trái -->
            <VBox spacing="10">
                <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
                <Label text="Danh sách sản phẩm của bạn" style="-fx-font-weight: bold;"/>
                <TableView fx:id="productTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="idColumn" text="Mã SP" prefWidth="110"/>
                        <TableColumn fx:id="typeColumn" text="Loại" prefWidth="90"/>
                        <TableColumn fx:id="nameColumn" text="Tên sản phẩm" prefWidth="170"/>
                        <TableColumn fx:id="priceColumn" text="Giá khởi điểm" prefWidth="120"/>
                        <TableColumn fx:id="detailColumn" text="Thông tin đặc thù" prefWidth="140"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>

            <!-- Form thêm/sửa sản phẩm bên phải -->
            <VBox spacing="12">
                <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>
                <Label fx:id="formTitleLabel" text="Thêm sản phẩm mới" style="-fx-font-size: 15px; -fx-font-weight: bold;"/>

                <Label text="Loại sản phẩm (*):"/>
                <ComboBox fx:id="typeComboBox" maxWidth="Infinity"/>

                <Label text="Tên sản phẩm (*):"/>
                <TextField fx:id="nameField" promptText="Nhập tên sản phẩm..."/>

                <Label text="Giá khởi điểm (VNĐ) (*):"/>
                <TextField fx:id="priceField" promptText="Ví dụ: 1500000"/>

                <!-- Trường động theo loại sản phẩm -->
                <VBox fx:id="artistBox" spacing="5">
                    <Label text="Nghệ sĩ / Tác giả (*):"/>
                    <TextField fx:id="artistField" promptText="Nhập tên tác giả..."/>
                </VBox>

                <VBox fx:id="originBox" spacing="5" visible="false" managed="false">
                    <Label text="Nguồn gốc / Xuất xứ (*):"/>
                    <TextField fx:id="originField" promptText="Nhập xuất xứ cổ vật..."/>
                </VBox>

                <VBox fx:id="yearBox" spacing="5" visible="false" managed="false">
                    <Label text="Năm sản xuất (*):"/>
                    <TextField fx:id="yearField" promptText="Ví dụ: 2022"/>
                </VBox>

                <HBox spacing="10" style="-fx-padding: 10 0 0 0;">
                    <Button fx:id="createButton" text="Thêm mới" onAction="#handleCreate" style="-fx-font-weight: bold;"/>
                    <Button fx:id="updateButton" text="Cập nhật" onAction="#handleUpdate" disable="true"/>
                    <Button fx:id="deleteButton" text="Xóa" onAction="#handleDelete" disable="true"/>
                    <Button text="Làm mới form" onAction="#handleClearForm"/>
                </HBox>
            </VBox>
        </SplitPane>
    </center>

    <bottom>
        <HBox style="-fx-padding: 10 20; -fx-border-color: #cccccc; -fx-border-width: 1 0 0 0;">
            <Label fx:id="statusLabel" text="Sẵn sàng."/>
        </HBox>
    </bottom>
</BorderPane>