<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16" prefWidth="680" prefHeight="500"
      style="-fx-padding: 28; -fx-background-color: white;"
      xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.auction.app.client.controller.AuctionRoomController">
    <Button text="Quay lại danh sách" onAction="#backToList" />
    <Label text="PHÒNG ĐẤU GIÁ" style="-fx-font-size: 24; -fx-font-weight: bold;" />
    <Label fx:id="productLabel" style="-fx-font-size: 20; -fx-font-weight: bold;" />
    <Label fx:id="auctionIdLabel" />
    <Label fx:id="statusLabel" />
    <Label fx:id="endLabel" />
    <Label text="Giá hiện tại" />
    <Label fx:id="priceLabel" style="-fx-font-size: 25; -fx-font-weight: bold;" />
    <HBox spacing="10">
        <TextField fx:id="bidderField" promptText="Mã người đấu giá" />
        <TextField fx:id="amountField" promptText="Giá muốn đặt" />
        <Button fx:id="bidButton" text="Đặt giá" onAction="#placeBid" />
    </HBox>
    <Label fx:id="messageLabel" wrapText="true" />
</VBox>
