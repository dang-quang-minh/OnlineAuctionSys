<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Scene?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<Scene stylesheets="@styles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
       fx:controller="com.auction.app.client.controller.SignupController">
    <HBox prefHeight="650.0" prefWidth="1000.0">
        <!-- 2/3 BÊN TRÁI: THÔNG TIN HỆ THỐNG VÀ QUYỀN LỢI TÀI KHOẢN -->
        <VBox prefWidth="620.0" styleClass="info-panel-2-3" spacing="22" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT">
                <Label styleClass="gold-badge" text="★ ĐẤU GIÁ NHANH GỌN" />
                <Region HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" onAction="#handleToggleTheme"
                        styleClass="btn-theme-toggle" text="🌓 Chuyển Giao Diện" />
            </HBox>

            <VBox spacing="6">
                <Label styleClass="app-title" text="ĐẤU GIÁ NHANH GỌN" />
                <Label styleClass="text-muted"
                       text="Đăng ký tài khoản nhanh chóng để bắt đầu tham gia săn hàng hoặc đăng bán." />
            </VBox>

            <Separator opacity="0.15" />

            <!-- Thông tin về vai trò cho người dùng -->
            <VBox spacing="14" VBox.vgrow="ALWAYS">
                <VBox spacing="6" styleClass="info-card">
                    <Label style="-fx-font-weight: 800; -fx-font-size: 14px;" text="👤 Dành Cho Người Mua (BIDDER)" />
                    <Label styleClass="text-muted"
                           text="• Truy cập không giới hạn vào toàn bộ phòng đấu giá trực tiếp." />
                    <Label styleClass="text-muted"
                           text="• Trả giá theo thời gian thực với bảng nhảy số tự động, minh bạch." />
                </VBox>

                <VBox spacing="6" styleClass="info-card">
                    <Label style="-fx-font-weight: 800; -fx-font-size: 14px;" text="🏷 Dành Cho Người Bán (SELLER)" />
                    <Label styleClass="text-muted"
                           text="• Quản lý danh mục hàng hóa (Nghệ thuật, Cổ vật, Xe cộ)." />
                    <Label styleClass="text-muted"
                           text="• Đưa sản phẩm lên sàn đấu giá công khai, định mức giá sàn linh hoạt." />
                </VBox>

                <VBox spacing="6" styleClass="info-card">
                    <Label style="-fx-font-weight: 800; -fx-font-size: 13px;" text="🔒 Quy Chuẩn An Toàn" />
                    <Label styleClass="text-muted"
                           text="• Tên đăng nhập từ 3-20 ký tự, mật khẩu tối thiểu 6 ký tự bảo vệ phiên giao dịch." />
                </VBox>
            </VBox>

            <Label styleClass="text-muted" style="-fx-font-size: 11px;"
                   text="Thông tin cá nhân được bảo mật an toàn theo tiêu chuẩn." />
        </VBox>

        <!-- 1/3 BÊN PHẢI: FORM ĐĂNG KÝ -->
        <VBox prefWidth="380.0" styleClass="form-panel-1-3" spacing="16" HBox.hgrow="NEVER">
            <VBox spacing="4" alignment="CENTER_LEFT">
                <Label styleClass="panel-title" text="Tạo tài khoản" />
                <Label styleClass="text-muted" text="Điền các thông tin để đăng ký thành viên" />
            </VBox>

            <VBox spacing="12">
                <HBox spacing="10">
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label styleClass="field-label" text="TÊN ĐĂNG NHẬP" />
                        <TextField fx:id="usernameField" promptText="Tên tài khoản" />
                    </VBox>
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label styleClass="field-label" text="VAI TRÒ" />
                        <ComboBox fx:id="roleComboBox" maxWidth="Infinity" promptText="Chọn vai trò" />
                    </VBox>
                </HBox>

                <VBox spacing="5">
                    <Label styleClass="field-label" text="ĐỊA CHỈ EMAIL" />
                    <TextField fx:id="emailField" promptText="name@example.com" />
                </VBox>

                <VBox spacing="5">
                    <Label styleClass="field-label" text="MẬT KHẨU" />
                    <PasswordField fx:id="passwordField" promptText="Tối thiểu 6 ký tự" />
                </VBox>

                <VBox spacing="5">
                    <Label styleClass="field-label" text="XÁC NHẬN MẬT KHẨU" />
                    <PasswordField fx:id="confirmPasswordField" promptText="Nhập lại mật khẩu" />
                </VBox>

                <Label fx:id="errorLabel" styleClass="error-text" wrapText="true" />

                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#handleSignup"
                        styleClass="btn-gold" text="XÁC NHẬN ĐĂNG KÝ" />
            </VBox>

            <HBox alignment="CENTER" spacing="6">
                <Label styleClass="text-muted" text="Đã có tài khoản?" />
                <Hyperlink onAction="#backToLogin" styleClass="hyperlink" text="Đăng nhập ngay" />
            </HBox>
        </VBox>
    </HBox>
</Scene>
