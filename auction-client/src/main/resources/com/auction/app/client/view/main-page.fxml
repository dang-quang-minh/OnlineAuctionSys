<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane stylesheets="@styles.css" prefHeight="650.0" prefWidth="1040.0"
            xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.auction.app.client.controller.MainPageController">
    <!-- THANH HEADER ĐIỀU HƯỚNG TRÊN CÙNG -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16" styleClass="top-bar">
            <VBox spacing="2">
                <HBox alignment="CENTER_LEFT" spacing="6">
                    <Label style="-fx-font-size: 19px; -fx-font-weight: 900; -fx-text-fill: #f59e0b;" text="🏛" />
                    <Label styleClass="header-brand-title" text="ĐẤU GIÁ NHANH GỌN" />
                </HBox>
                <Label styleClass="text-muted" style="-fx-font-size: 11px;"
                       text="Sàn giao dịch &amp; đấu giá trực tiếp theo thời gian thực" />
            </VBox>

            <Region HBox.hgrow="ALWAYS" />

            <!-- Huy hiệu người dùng -->
            <Label fx:id="welcomeLabel" styleClass="user-tag" text="Khách" />

            <!-- Nút chuyển Theme Sáng / Tối -->
            <Button mnemonicParsing="false" onAction="#handleToggleTheme"
                    styleClass="btn-theme-toggle" text="🌓 Giao Diện" />

            <!-- Nút làm mới dữ liệu -->
            <Button mnemonicParsing="false" onAction="#handleRefresh"
                    styleClass="btn-refresh" text="🔄 Làm mới" />

            <Button fx:id="manageProductsButton" managed="false"
                    onAction="#handleOpenSellerProducts" text="Quản lý sản phẩm" visible="false"/>

            <!-- Nút đăng xuất -->
            <Button mnemonicParsing="false" onAction="#handleLogout"
                    styleClass="btn-logout" text="Đăng xuất" />
        </HBox>
    </top>

    <!-- NỘI DUNG CHÍNH ĐA DẠNG HƠN -->
    <center>
        <VBox spacing="14" style="-fx-padding: 20 28;" BorderPane.alignment="CENTER">
            <!-- 3 Thẻ thống kê tổng quan (Stats Overview) -->
            <HBox spacing="16">
                <!-- Thẻ 1: Số phiên đang mở -->
                <HBox spacing="12" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS" styleClass="stat-card">
                    <Label style="-fx-font-size: 26px;" text="🟢" />
                    <VBox spacing="2">
                        <Label styleClass="text-muted" style="-fx-font-size: 11px; -fx-font-weight: bold;"
                               text="PHIÊN ĐANG MỞ" />
                        <HBox alignment="BASELINE_LEFT" spacing="6">
                            <Label fx:id="openAuctionsCountLabel" styleClass="stat-card-number"
                                   text="0" />
                            <Label styleClass="text-muted" text="phiên hoạt động" />
                        </HBox>
                    </VBox>
                </HBox>

                <!-- Thẻ 2: Phân loại danh mục -->
                <HBox spacing="12" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS" styleClass="stat-card">
                    <Label style="-fx-font-size: 26px;" text="💎" />
                    <VBox spacing="2">
                        <Label styleClass="text-muted" style="-fx-font-size: 11px; -fx-font-weight: bold;"
                               text="DANH MỤC TÀI SẢN" />
                        <Label styleClass="stat-card-title" text="Tranh, Cổ Vật, Xe Cộ" />
                    </VBox>
                </HBox>

                <!-- Thẻ 3: Trạng thái kết nối Realtime -->
                <HBox spacing="12" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS" styleClass="stat-card">
                    <Label style="-fx-font-size: 26px;" text="⚡" />
                    <VBox spacing="2">
                        <Label styleClass="text-muted" style="-fx-font-size: 11px; -fx-font-weight: bold;"
                               text="KẾT NỐI REALTIME" />
                        <Label styleClass="stat-card-title" text="Socket &amp; Observer Trực Tiếp" />
                    </VBox>
                </HBox>
            </HBox>

            <!-- Tiêu đề danh sách phiên -->
            <HBox alignment="CENTER_LEFT">
                <VBox spacing="2">
                    <Label styleClass="section-heading"
                           text="DANH SÁCH CÁC PHIÊN ĐẤU GIÁ" />
                    <Label styleClass="text-muted" style="-fx-font-size: 12px;"
                           text="Chọn một phiên để xem chi tiết hoặc thực hiện trả giá cạnh tranh" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
            </HBox>

            <!-- Bảng danh sách phiên đấu giá -->
            <TableView fx:id="auctionTable" VBox.vgrow="ALWAYS" styleClass="table-view">
                <columns>
                    <TableColumn prefWidth="100.0" text="MÃ PHIÊN">
                        <cellValueFactory><PropertyValueFactory property="auctionId" /></cellValueFactory>
                    </TableColumn>
                    <TableColumn prefWidth="230.0" text="SẢN PHẨM">
                        <cellValueFactory><PropertyValueFactory property="productName" /></cellValueFactory>
                    </TableColumn>
                    <TableColumn prefWidth="130.0" text="NGƯỜI BÁN">
                        <cellValueFactory><PropertyValueFactory property="seller" /></cellValueFactory>
                    </TableColumn>
                    <TableColumn prefWidth="130.0" text="GIÁ KHỞI ĐIỂM">
                        <cellValueFactory><PropertyValueFactory property="startingPrice" /></cellValueFactory>
                    </TableColumn>
                    <TableColumn prefWidth="130.0" text="GIÁ HIỆN TẠI">
                        <cellValueFactory><PropertyValueFactory property="currentPrice" /></cellValueFactory>
                    </TableColumn>
                    <TableColumn prefWidth="80.0" text="LƯỢT BID">
                        <cellValueFactory><PropertyValueFactory property="bidCount" /></cellValueFactory>
                    </TableColumn>
                    <TableColumn prefWidth="160.0" text="THỜI GIAN KẾT THÚC">
                        <cellValueFactory><PropertyValueFactory property="endTime" /></cellValueFactory>
                    </TableColumn>
                    <TableColumn prefWidth="110.0" text="TRẠNG THÁI">
                        <cellValueFactory><PropertyValueFactory property="status" /></cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="actionColumn" prefWidth="90.0" text="THAO TÁC">
                        <cellValueFactory><PropertyValueFactory property="action" /></cellValueFactory>
                    </TableColumn>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>

            <!-- Thanh thông báo trạng thái & hướng dẫn nhanh -->
            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="stat-card">
                <Label style="-fx-font-weight: 800; -fx-text-fill: #f59e0b;" text="ℹ THÔNG BÁO:" />
                <Label fx:id="messageLabel" styleClass="text-muted" style="-fx-font-size: 12px;"
                       text="Đang kết nối dữ liệu từ máy chủ..." />
            </HBox>
        </VBox>
    </center>
</BorderPane>
