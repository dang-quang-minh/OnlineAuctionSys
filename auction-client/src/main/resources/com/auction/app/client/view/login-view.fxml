<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Scene?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<Scene stylesheets="@styles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
       fx:controller="com.auction.app.client.controller.LoginController">
    <HBox prefHeight="620.0" prefWidth="980.0">
        <!-- 2/3 BÊN TRÁI: THÔNG TIN HỆ THỐNG VÀ HƯỚNG DẪN CẦN THIẾT -->
        <VBox prefWidth="620.0" styleClass="info-panel-2-3" spacing="22" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT">
                <Label styleClass="gold-badge" text="★ ĐẤU GIÁ NHANH GỌN" />
                <Region HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" onAction="#handleToggleTheme"
                        styleClass="btn-theme-toggle" text="🌓 Chuyển Giao Diện" />
            </HBox>

            <VBox spacing="6">
                <Label styleClass="app-title" text="ĐẤU GIÁ NHANH GỌN" />
                <Label styleClass="text-muted"
                       text="Nền tảng giao dịch tài sản &amp; đấu giá trực tiếp theo thời gian thực." />
            </VBox>

            <Separator opacity="0.15" />

            <!-- Các khối thông tin cần thiết cho người dùng -->
            <VBox spacing="14" VBox.vgrow="ALWAYS">
                <VBox spacing="6" styleClass="info-card">
                    <Label style="-fx-font-weight: 800; -fx-font-size: 14px;" text="📌 3 Bước Tham Gia Dễ Dàng" />
                    <Label styleClass="text-muted"
                           text="1. Đăng ký &amp; chọn vai trò (Bidder tham gia đặt giá hoặc Seller đưa hàng lên sàn)." />
                    <Label styleClass="text-muted"
                           text="2. Theo dõi các phiên đấu giá trực tiếp – giá cập nhật realtime từng giây." />
                    <Label styleClass="text-muted"
                           text="3. Đặt mức giá cạnh tranh và nhận thông báo chốt người thắng tức thì khi hết giờ." />
                </VBox>

                <VBox spacing="6" styleClass="info-card">
                    <Label style="-fx-font-weight: 800; -fx-font-size: 14px;" text="🛡 Minh Bạch &amp; Bảo Vệ Đấu Giá" />
                    <Label styleClass="text-muted"
                           text="• Cơ chế chống xung đột lệnh đặt giá đồng thời (concurrency safe) tuyệt đối công bằng." />
                    <Label styleClass="text-muted"
                           text="• Kiểm tra quyền sở hữu sản phẩm – đảm bảo người bán chính danh và hàng hóa minh bạch." />
                </VBox>
            </VBox>

            <Label styleClass="text-muted" style="-fx-font-size: 11px;"
                   text="Hệ thống hoạt động 24/7 – Kết nối ổn định và lưu trữ dữ liệu an toàn." />
        </VBox>

        <!-- 1/3 BÊN PHẢI: FORM ĐĂNG NHẬP -->
        <VBox prefWidth="360.0" styleClass="form-panel-1-3" spacing="18" HBox.hgrow="NEVER">
            <VBox spacing="4" alignment="CENTER_LEFT">
                <Label styleClass="panel-title" text="Đăng nhập" />
                <Label styleClass="text-muted" text="Nhập tài khoản để vào phòng đấu giá" />
            </VBox>

            <VBox spacing="14">
                <VBox spacing="5">
                    <Label styleClass="field-label" text="TÊN ĐĂNG NHẬP" />
                    <TextField fx:id="usernameField" onAction="#handleLogin" promptText="Nhập tên đăng nhập" />
                </VBox>

                <VBox spacing="5">
                    <Label styleClass="field-label" text="MẬT KHẨU" />
                    <StackPane>
                        <PasswordField fx:id="passwordField" onAction="#handleLogin" promptText="Nhập mật khẩu" />
                        <TextField fx:id="visiblePasswordField" managed="false" onAction="#handleLogin"
                                   promptText="Nhập mật khẩu" visible="false" />
                    </StackPane>
                </VBox>

                <HBox alignment="CENTER_LEFT">
                    <CheckBox fx:id="showPasswordCheckBox" mnemonicParsing="false"
                              onAction="#togglePasswordVisibility" text="Hiển thị mật khẩu" />
                </HBox>

                <Label fx:id="errorLabel" styleClass="error-text" wrapText="true" />

                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#handleLogin"
                        styleClass="btn-gold" text="VÀO HỆ THỐNG" />
            </VBox>

            <HBox alignment="CENTER" spacing="6">
                <Label styleClass="text-muted" text="Chưa có tài khoản?" />
                <Hyperlink onAction="#openSignup" styleClass="hyperlink" text="Đăng ký ngay" />
            </HBox>

            <!-- Hộp nhắc tài khoản mẫu -->
            <VBox spacing="3" style="-fx-background-color: rgba(125,125,125,0.08); -fx-padding: 8 12; -fx-background-radius: 8;">
                <Label style="-fx-font-weight: 700; -fx-font-size: 11px;" text="💡 Tài khoản trải nghiệm:" />
                <Label styleClass="text-muted" style="-fx-font-size: 11px;" text="• Bidder: demo / demo  • Seller: seller / demo" />
            </VBox>
        </VBox>
    </HBox>
</Scene>
